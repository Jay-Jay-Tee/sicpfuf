#### array sum and swap (§3)
def swap(A, i, j):
    temp = A[i]
    A[i] = A[j]
    A[j] = temp
def reverse_array(A):
    n = len(A)
    for i in range(n // 2):
        swap(A, i, n - 1 - i)
A = [1, 2, 3, 4, 5]
reverse_array(A)
print(A)
#### selection sort array (§3)
def selection_sort(A):
    n = len(A)
    for i in range(n - 1):
        smallest = i
        for j in range(i + 1, n):
            if A[j] < A[smallest]:
                smallest = j
        t = A[i]
        A[i] = A[smallest]
        A[smallest] = t
A = [5, 2, 9, 1, 5, 6]
selection_sort(A)
print(A)
#### memo fib array (§3)
def memo_fib(n):
    memo = [None] * (n + 1)
    def fib(k):
        if memo[k] is not None:
            return memo[k]
        else:
            result = k if k <= 1 else fib(k - 1) + fib(k - 2)
            memo[k] = result
            return result
    return fib(n)
print(memo_fib(50))
#### binary search (§3)
def binary_search(A, v):
    low = 0
    high = len(A) - 1
    while low <= high:
        mid = math_floor((low + high) / 2)
        if v == A[mid]:
            return mid
        elif v < A[mid]:
            high = mid - 1
        else:
            low = mid + 1
    return -1
A = [1, 3, 5, 7, 9, 11]
print(binary_search(A, 7), binary_search(A, 4))
