print(f(False))
#### nonlocal without binding (§3)
x = 1
def f():
    nonlocal x
    x = 2
f()
#### nonlocal two levels (§3)
def outer():
    n = 0
    def middle():
        def inner():
            nonlocal n
            n = n + 1
            return n
        return inner()
    middle()
    return middle()
print(outer())
#### counter object (§3)
def make_counter():
    count = 0
    def next():
        nonlocal count
        count = count + 1
        return count
    return next
c = make_counter()
c()
c()
print(c(), make_counter()())
