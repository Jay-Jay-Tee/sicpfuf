#### destructive append (§3)
def d_append(xs, ys):
    if is_none(xs):
        return ys
    else:
        set_tail(xs, d_append(tail(xs), ys))
        return xs
a = llist(1, 2)
b = llist(3)
c = d_append(a, b)
print(a, c, a is c)
#### bank account closure (§3)
def make_withdraw(balance):
    def withdraw(amount):
        nonlocal balance
        if balance >= amount:
            balance = balance - amount
            return balance
        else:
            return "Insufficient funds"
    return withdraw
w1 = make_withdraw(100)
w2 = make_withdraw(100)
print(w1(50), w1(70), w1(40), w2(10))
#### global statement (§3)
count = 0
def bump():
    global count
    count = count + 1
    return count
bump()
bump()
print(count)
#### global creates name (§3)
def setup():
    global made
    made = 5
setup()
print(made)
