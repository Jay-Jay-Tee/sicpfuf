#### pairs (§2)
p = pair(1, 2)
print(p, head(p), tail(p), is_pair(p), is_pair(1), is_pair(None), pair(pair(1, 2), pair(3, 4)))
print(pair(1, None), pair(None, None), pair("a", "b"), pair(1.5, True))
#### llist construction (§2)
print(llist(1, 2, 3), llist(), llist(1), llist(llist(1, 2), llist(3)), llist("a", "b"))
print(pair(1, pair(2, pair(3, None))), head(tail(llist(1, 2, 3))), tail(tail(tail(llist(1, 2, 3)))))
#### is_none is_llist (§2)
print(is_none(None), is_none(llist()), is_none(llist(1)), is_llist(None), is_llist(llist(1, 2)), is_llist(pair(1, 2)), is_llist(1))
#### length and ref (§2)
xs = llist(10, 20, 30, 40)
print(length(xs), length(None), llist_ref(xs, 0), llist_ref(xs, 3), len(xs), len(llist(1)))
#### map filter reduce (§2)
xs = enum_llist(1, 10)
print(map(lambda x: x * x, xs))
print(filter(lambda x: x % 2 == 0, xs))
print(reduce(lambda x, y: x + y, 0, xs), reduce(lambda x, y: pair(x, y), None, llist(1, 2, 3)))
print(reduce(lambda x, y: x - y, 0, llist(1, 2, 3)), reduce(lambda x, acc: acc + 1, 0, xs))
print(map(lambda x: x, None), filter(lambda x: True, None), reduce(lambda a, b: a, 99, None))
#### append reverse (§2)
print(append(llist(1, 2), llist(3, 4)), append(None, llist(1)), append(llist(1), None), append(None, None))
print(reverse(llist(1, 2, 3)), reverse(None), reverse(llist(llist(1, 2), 3)))
#### member remove (§2)
xs = llist(1, 2, 3, 2, 1)
print(member(2, xs), member(9, xs), member(1, None), remove(2, xs), remove(9, xs), remove_all(2, xs), remove_all(1, xs))
print(member("b", llist("a", "b", "c")), remove("a", llist("a")))
#### enum build (§2)
print(enum_llist(1, 5), enum_llist(3, 3), enum_llist(5, 1), build_llist(lambda i: i * i, 5), build_llist(lambda i: i, 0))
print(enum_llist(1.5, 4))
#### for_each (§2)
r = for_each(lambda x: print(x), llist(1, 2, 3))
print(r)
#### llist_to_string (§2)
print(llist_to_string(llist(1, "a", llist(2))), llist_to_string(None), llist_to_string(pair(1, 2)))
#### print_llist (§2)
print_llist(llist(1, 2, 3))
print_llist(None)
print_llist(pair(1, 2))
print_llist(llist(llist(1, 2), "a", pair(3, 4)))
print_llist(5)
print_llist(llist(1, llist(2, llist(3))))
#### equality on lists (§2)
print(llist(1, 2) == llist(1, 2), llist(1, 2) == llist(1, 3), pair(1, 2) != pair(1, 2), None == llist(), llist(1) == 1)
print(pair(1, pair(2, None)) == llist(1, 2), llist("a") == llist("a"), llist(1, 2) == llist(1, 2, 3))
#### equality nested bool error (§2)
print(pair(1, True) == pair(1, True))
#### equality nested bool short circuit (§2)
print(pair(1, True) == pair(2, True))
#### equality nested function error (§2)
print(pair(head, 2) == pair(head, 2))
#### strings in lists (§2)
print(llist("a", "it's", 'say "hi"', "a\nb"), pair("x", 1))
print(llist(1.0, 2.5, True, None, -1, abs, lambda x: x))
#### long list printing (§2)
print(enum_llist(1, 20))
print(enum_llist(1, 30))
print(enum_llist(1, 12), enum_llist(100, 125))
#### long nested printing (§2)
print(llist(enum_llist(1, 10), enum_llist(11, 20), enum_llist(21, 30)))
print(pair(enum_llist(1, 25), 5))
print(map(lambda x: llist(x, x * x), enum_llist(1, 8)))
#### very long list truncated (§2)
print(enum_llist(1, 120))
#### tree printing (§2)
t = llist(llist(1, 2), llist(3, llist(4, 5)), 6)
print(t)
print(llist(llist(llist(llist(1)))))
#### count leaves (§2)
def count_leaves(t):
    return 0 if is_none(t) else 1 if not is_pair(t) else count_leaves(head(t)) + count_leaves(tail(t))
print(count_leaves(llist(llist(1, 2), llist(3, 4), 5)))
#### head of none (§2)
print(head(None))
#### tail of number (§2)
print(tail(5))
#### head of empty after tail (§2)
xs = llist(1)
print(head(tail(xs)))
#### head arity (§2)
print(head(1, 2))
#### pair arity (§2)
print(pair(1))
#### llist_ref out of bounds (§2)
print(llist_ref(llist(1, 2), 5))
#### length of non list (§2) noline
print(length(5))
#### map over non list (§2) noline
print(map(lambda x: x, 5))
#### map with non function (§2) noline
print(map(5, llist(1, 2)))
#### deep recursion via library ok (§2)
xs = enum_llist(1, 5000)
print(length(xs), reduce(lambda a, b: a + b, 0, xs), length(map(lambda x: x + 1, xs)), length(append(xs, xs)), length(filter(lambda x: x > 100, xs)), head(reverse(xs)))
#### user recursion on long list fails (§2)
def my_sum(xs):
    return 0 if is_none(xs) else head(xs) + my_sum(tail(xs))
print(my_sum(enum_llist(1, 1000)))
print(my_sum(enum_llist(1, 2000)))
#### shadow library (§2)
def map(f, xs):
    return "mine"
print(map(1, 2), length(llist(1, 2)))
#### reassign library name twice (§2)
length = 1
length = 2
#### accumulate style sum of squares (§2)
def sum_odd_squares(tree):
    return (0 if is_none(tree)
            else (tree * tree if tree % 2 == 1 else 0) if is_number(tree)
            else sum_odd_squares(head(tree)) + sum_odd_squares(tail(tree)))
print(sum_odd_squares(llist(1, llist(2, 3), llist(4, llist(5)))))
#### permutations (§2)
def flatmap(f, seq):
    return reduce(append, None, map(f, seq))
def permutations(s):
    return (llist(None) if is_none(s)
            else flatmap(lambda x: map(lambda p: pair(x, p), permutations(remove(x, s))), s))
print(permutations(llist(1, 2, 3)))
#### subsets (§2)
def subsets(s):
    if is_none(s):
        return llist(None)
    else:
        rest = subsets(tail(s))
        return append(rest, map(lambda x: pair(head(s), x), rest))
print(subsets(llist(1, 2, 3)))
#### insertion sort (§2)
def insert(x, xs):
    return (llist(x) if is_none(xs)
            else pair(x, xs) if x <= head(xs)
            else pair(head(xs), insert(x, tail(xs))))
def insertion_sort(xs):
    return xs if is_none(xs) else insert(head(xs), insertion_sort(tail(xs)))
print(insertion_sort(llist(3, 1, 4, 1, 5, 9, 2, 6)))
#### draw_data returns arg (§2)
x = llist(1, 2)
print(is_function(draw_data))
#### list ops on strings (§2)
print(member("x", llist("a", "b")), llist("a") == llist("b"), append(llist("a"), llist("b")))
#### is_llist cyclic safe names (§2)
print(is_pair(llist()), is_llist(llist(None)), length(llist(None, None)))
#### str repr of lists (§2)
print(str(llist(1, "a")), repr(llist(1, "a")), str(None), repr(None), "x" + str(pair(1, 2)))
#### library uses user definitions (§2)
def reverse(xs):
    return 42
print(map(lambda x: x + 1, llist(1, 2)))
print(filter(lambda x: x > 1, llist(1, 2, 3)))
#### llist_ref messages (§2)
print(llist_ref(llist("a", "b"), 2))
#### llist_ref of none (§2)
print(llist_ref(None, 0))
