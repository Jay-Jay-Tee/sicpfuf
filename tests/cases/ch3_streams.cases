#### stream basics (§3)
s = pair(1, lambda: pair(2, lambda: None))
print(head(s), head(stream_tail(s)), stream_tail(stream_tail(s)))
print(s)
#### stream constructor (§3)
s = stream(1, 2, 3)
print(s, stream(), eval_stream(s, 3), stream_to_llist(s), stream_length(s))
#### integers and eval (§3)
ints = integers_from(1)
print(eval_stream(ints, 5), stream_ref(ints, 100), eval_stream(ints, 0), head(stream_tail(stream_tail(ints))))
#### stream map filter (§3)
ints = integers_from(1)
evens = stream_filter(lambda x: x % 2 == 0, ints)
squares = stream_map(lambda x: x * x, ints)
print(eval_stream(evens, 5), eval_stream(squares, 5), stream_ref(stream_map(lambda x: x + 1, evens), 3))
#### enum stream and conversions (§3)
print(stream_to_llist(enum_stream(1, 5)), enum_stream(5, 1), stream_to_llist(llist_to_stream(llist(1, 2, 3))), llist_to_stream(None))
print(stream_to_llist(build_stream(lambda i: i * 10, 4)), stream_length(enum_stream(1, 10)), is_stream(enum_stream(1, 3)), is_stream(llist(1, 2)), is_stream(None))
#### stream append reverse member remove (§3)
a = enum_stream(1, 3)
b = enum_stream(7, 9)
print(stream_to_llist(stream_append(a, b)), stream_to_llist(stream_reverse(a)), head(stream_member(2, a)), stream_member(9, a))
print(stream_to_llist(stream_remove(2, stream(1, 2, 3, 2))), stream_to_llist(stream_remove_all(2, stream(1, 2, 3, 2))))
#### stream for each (§3)
print(stream_for_each(lambda x: print(x), enum_stream(1, 3)))
#### laziness trace (§3)
def show(x):
    print("computing", x)
    return x
s = stream_map(show, enum_stream(1, 5))
print("made")
t = stream_tail(s)
print("tail taken")
print(stream_ref(s, 2))
#### implicit streams (§3)
def add_streams(s1, s2):
    return pair(head(s1) + head(s2), lambda: add_streams(stream_tail(s1), stream_tail(s2)))
ones = pair(1, lambda: ones)
integers = pair(1, lambda: add_streams(ones, integers))
fibs = pair(0, lambda: pair(1, lambda: add_streams(stream_tail(fibs), fibs)))
print(eval_stream(integers, 8), eval_stream(fibs, 12))
#### sieve (§3)
def sieve(s):
    return pair(head(s), lambda: sieve(stream_filter(lambda x: x % head(s) != 0, stream_tail(s))))
primes = sieve(integers_from(2))
print(eval_stream(primes, 15))
#### memo stream (§3)
def memo_fun(fun):
    already_run = False
    result = None
    def mfun():
        nonlocal already_run, result
        if not already_run:
            result = fun()
            already_run = True
            return result
        else:
            return result
    return mfun
def ms(m, s):
    print("M:", m)
    return s
def m_integers_from(n):
    return pair(n, memo_fun(lambda: ms(n, m_integers_from(n + 1))))
s = m_integers_from(1)
stream_ref(s, 3)
stream_ref(s, 3)
stream_ref(s, 5)
#### stream_tail of non stream (§3)
stream_tail(llist(1, 2))
#### stream_tail of none (§3)
stream_tail(None)
#### stream_ref past end (§3) noline
print(stream_ref(enum_stream(1, 3), 5))
#### eval_stream too many (§3) noline
print(eval_stream(enum_stream(1, 3), 5))
#### stream to llist depth (§3)
print(length(stream_to_llist(enum_stream(1, 900))))
