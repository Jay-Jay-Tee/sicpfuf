#### insertion sort (§4 typed)
def insert(x: int, xs: LList[int]) -> LList[int]:
    if is_none(xs):
        return llist(x)
    elif x <= head(xs):
        return pair(x, xs)
    else:
        return pair(head(xs), insert(x, tail(xs)))
def insertion_sort(xs: LList[int]) -> LList[int]:
    return None if is_none(xs) else insert(head(xs), insertion_sort(tail(xs)))
print_llist(insertion_sort(llist(3, 1, 2)))
#### merge sort (§4 typed)
def take(xs: LList[int], n: int) -> LList[int]:
    return None if n == 0 else pair(head(xs), take(tail(xs), n - 1))
def drop(xs: LList[int], n: int) -> LList[int]:
    return xs if n == 0 else drop(tail(xs), n - 1)
def merge(xs: LList[int], ys: LList[int]) -> LList[int]:
    if is_none(xs):
        return ys
    elif is_none(ys):
        return xs
    elif head(xs) < head(ys):
        return pair(head(xs), merge(tail(xs), ys))
    else:
        return pair(head(ys), merge(xs, tail(ys)))
def merge_sort(xs: LList[int]) -> LList[int]:
    if is_none(xs) or is_none(tail(xs)):
        return xs
    mid: int = length(xs) // 2
    return merge(merge_sort(take(xs, mid)), merge_sort(drop(xs, mid)))
print_llist(merge_sort(llist(5, 2, 4, 1)))
#### count change (§4 typed)
def cc(amount: int, kinds: int) -> int:
    if amount == 0:
        return 1
    elif amount < 0 or kinds == 0:
        return 0
    else:
        return cc(amount, kinds - 1) + cc(amount - first_denomination(kinds), kinds)
def first_denomination(kinds: int) -> int:
    return 1 if kinds == 1 else 5 if kinds == 2 else 10 if kinds == 3 else 25 if kinds == 4 else 50
print(cc(100, 5))
#### sqrt newton (§4 typed)
def sqrt_iter(guess: float, x: float) -> float:
    return guess if good_enough(guess, x) else sqrt_iter(improve(guess, x), x)
def improve(guess: float, x: float) -> float:
    return (guess + x / guess) / 2
def good_enough(guess: float, x: float) -> bool:
    return abs(guess * guess - x) < 0.001
def sqrt(x: float) -> float:
    return sqrt_iter(1, x)
print(sqrt(2))
#### fast expt (§4 typed)
def fast_expt(b: int, n: int) -> int:
    if n == 0:
        return 1
    elif n % 2 == 0:
        return fast_expt(b, n // 2) ** 2
    else:
        return b * fast_expt(b, n - 1)
print(fast_expt(2, 10))
#### bank account (§4 typed)
def make_account(balance: int) -> Callable[[str, int], int]:
    def dispatch(m: str, amount: int) -> int:
        nonlocal balance
        if m == "withdraw":
            balance = balance - amount
        elif m == "deposit":
            balance = balance + amount
        return balance
    return dispatch
acc = make_account(100)
print(acc("withdraw", 30), acc("deposit", 5))
#### sieve (§4 typed)
def integers_from2(n: int) -> Stream[int]:
    return pair(n, lambda: integers_from2(n + 1))
def is_divisible(x: int, y: int) -> bool:
    return x % y == 0
def sieve(s: Stream[int]) -> Stream[int]:
    if is_none(s):
        return None
    return pair(head(s), lambda: sieve(stream_filter(lambda x: not is_divisible(x, head(s)), stream_tail(s))))
primes: Stream[int] = sieve(integers_from2(2))
print_llist(eval_stream(primes, 5))
#### memo list (§4 typed)
def fib(n: int) -> int:
    memo: list[int] = []
    for i in range(n + 1):
        memo = memo + [0]
    def f(k: int) -> int:
        if k < 2:
            return k
        if memo[k] != 0:
            return memo[k]
        r: int = f(k - 1) + f(k - 2)
        memo[k] = r
        return r
    return f(n)
print(fib(20))
#### hanoi (§4 typed)
def hanoi(n: int, a: str, b: str, c: str) -> None:
    if n == 0:
        return None
    hanoi(n - 1, a, c, b)
    print("move " + a + " to " + b)
    hanoi(n - 1, c, b, a)
hanoi(2, "A", "B", "C")
#### queue with pairs (§4 typed)
type Queue = Pair[LList[int], LList[int]]
def make_queue() -> Queue:
    return pair(None, None)
def is_empty(q: Queue) -> bool:
    return is_none(head(q))
def enqueue(q: Queue, x: int) -> None:
    item: LList[int] = pair(x, None)
    if is_none(head(q)):
        set_head(q, item)
        set_tail(q, item)
    else:
        last: LList[int] = tail(q)
        if not is_none(last):
            set_tail(last, item)
        set_tail(q, item)
q: Queue = make_queue()
enqueue(q, 1)
enqueue(q, 2)
print_llist(head(q))
#### while counting (§4 typed)
def sum_to(n: int) -> int:
    i: int = 0
    s: int = 0
    while i <= n:
        s = s + i
        i = i + 1
    return s
print(sum_to(100))
