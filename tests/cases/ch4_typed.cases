square: Callable[[int], int] = lambda x: x * x
compose: Callable[[Callable[[int], int], Callable[[int], int]], Callable[[int], int]] = lambda f, g: lambda x: f(g(x))
print(compose(square, square)(3))
#### currying (§4 typed)
def adder(x: int) -> Callable[[int], int]:
    return lambda y: x + y
print(adder(1)(2))
#### type alias rational (§4 typed)
type Rat = Pair[int, int]
def make_rat(n: int, d: int) -> Rat:
    return pair(n, d)
def numer(r: Rat) -> int:
    return head(r)
def denom(r: Rat) -> int:
    return tail(r)
def add_rat(a: Rat, b: Rat) -> Rat:
    return make_rat(numer(a) * denom(b) + numer(b) * denom(a), denom(a) * denom(b))
r: Rat = add_rat(make_rat(1, 2), make_rat(1, 3))
print(numer(r), denom(r))
#### streams (§4 typed)
def from_n(n: int) -> Stream[int]:
    return pair(n, lambda: from_n(n + 1))
s: Stream[int] = from_n(1)
t: Stream[int] = stream_map(lambda x: x * 2, s)
print_llist(eval_stream(t, 4))
print(stream_ref(integers_from(10), 3))
#### while loop llist (§4 typed)
def last(xs: Pair[int, LList[int]]) -> int:
    ys: LList[int] = xs
    while not is_none(ys):
        if is_none(tail(ys)):
            return head(ys)
        ys = tail(ys)
    return 0
print(last(pair(1, llist(2, 3))))
