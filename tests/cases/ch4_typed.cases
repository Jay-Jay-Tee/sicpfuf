#### make counter nonlocal (§4 typed)
def make_counter() -> Callable[[], int]:
    count: int = 0
    def inc() -> int:
        nonlocal count
        count = count + 1
        return count
    return inc
c: Callable[[], int] = make_counter()
c()
print(c())
