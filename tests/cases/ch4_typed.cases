print(show(safe_div(1, 2)), show(safe_div(1, 0)))
#### and or narrowing (§4 typed)
def starts_positive(xs: LList[int]) -> bool:
    return not is_none(xs) and head(xs) > 0
def empty_or_zero(xs: LList[int]) -> bool:
    return is_none(xs) or head(xs) == 0
print(starts_positive(llist(1)), starts_positive(None), empty_or_zero(llist(0)))
#### error noreturn (§4 typed)
def check_positive(x: int) -> int:
