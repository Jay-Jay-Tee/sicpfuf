#### factorial (§4 typed)
def factorial(n: int) -> int:
    return 1 if n == 0 else n * factorial(n - 1)
print(factorial(5))
#### fib iterative (§4 typed)
def fib(n: int) -> int:
    a: int = 0
    b: int = 1
    for i in range(n):
        t: int = a + b
        a = b
        b = t
    return a
print(fib(30))
#### floats and ints (§4 typed)
def average(x: float, y: float) -> float:
    return (x + y) / 2
print(average(3, 4), average(1.5, 2))
r: float = 7 // 2
print(r)
#### strings (§4 typed)
def greet(name: str) -> str:
    return "Hello, " + name + "!"
print(greet("Ada"), len(greet("Ada")), str(42) + "!")
#### length of llist (§4 typed)
def length2(xs: LList[int]) -> int:
    return 0 if is_none(xs) else 1 + length2(tail(xs))
print(length2(llist(1, 2, 3)))
#### sum with if is_none (§4 typed)
def sum_list(xs: LList[int]) -> int:
    if is_none(xs):
        return 0
    return head(xs) + sum_list(tail(xs))
print(sum_list(llist(1, 2, 3, 4)))
#### is None narrowing (§4 typed)
def sum_list(xs: LList[int]) -> int:
    return 0 if xs is None else head(xs) + sum_list(tail(xs))
def count(xs: LList[str]) -> int:
    if xs is not None:
        return 1 + count(tail(xs))
    else:
        return 0
print(sum_list(llist(4, 5)), count(llist("a", "b", "c")))
#### generic map (§4 typed)
def map_llist[A, B](f: Callable[[A], B], xs: LList[A]) -> LList[B]:
    return None if is_none(xs) else pair(f(head(xs)), map_llist(f, tail(xs)))
print_llist(map_llist(lambda x: x * x, llist(1, 2, 3)))
print_llist(map_llist(lambda s: s + "!", llist("a", "b")))
