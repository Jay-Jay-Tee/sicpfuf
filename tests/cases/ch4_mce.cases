#### parse literals and names (§4)
print(parse("1"), parse("x"), parse("'s'"), parse("True"), parse("None"), parse("1.5"))
#### parse operators (§4)
print(parse("1 + 2 * 3"))
print(parse("-x"), parse("not p"), parse("+x"))
print(parse("a and b or c"), parse("a < b"), parse("a == b"), parse("a is not b"))
#### parse assignment and names (§4)
print(parse("x = 4"))
print(parse("xs[0] = 4"), parse("xs[i]"))
#### parse sequence (§4)
print(parse("x = 1\ny = 2\nx + y"))
print(parse(""))
#### parse function definition (§4)
print(parse("def f(x, y):\n    return x + y"))
print(parse("def g():\n    x = 1\n    return x"))
print(parse("def h(a, *rest):\n    return a"))
#### parse lambda and application (§4)
print(parse("lambda x: x + 1"))
print(parse("f(1, 2)"), parse("f()"), parse("(lambda: 1)()"), parse("f(*xs)"))
#### parse conditionals (§4)
print(parse("a if p else b"))
print(parse("if p:\n    x = 1\nelse:\n    x = 2"))
print(parse("if p:\n    x = 1"))
print(parse("if p:\n    x = 1\nelif q:\n    x = 2\nelse:\n    x = 3"))
#### parse loops (§4)
print(parse("while x < 3:\n    x = x + 1"))
print(parse("for i in range(3):\n    print(i)"))
print(parse("for i in range(1, n, 2):\n    break\n    continue"))
#### parse misc statements (§4)
print(parse("def f():\n    global a\n    nonlocal b, c\n    pass"))
print(parse("[1, 2, 3]"), parse("[]"))
print(parse("from rune import show, heart"))
#### parse result is llist (§4)
t = parse("x = 1 + 2")
print(head(t), head(tail(t)), head(head(tail(tail(t)))), is_llist(t), length(t))
#### parse error (§4)
print(parse("x = = 1"))
#### parse non string (§4)
print(parse(5))
#### tokenize (§4)
print(tokenize("x = 1 + 2"))
print(tokenize("def f(x):\n    return x"))
#### apply in underlying python (§4)
print(apply_in_underlying_python(lambda x, y: x + y, llist(1, 2)), apply_in_underlying_python(abs, llist(-5)), apply_in_underlying_python(max, llist(1, 9, 3)))
def f(a, b, c):
    return a * b - c
print(apply_in_underlying_python(f, llist(2, 3, 4)), apply_in_underlying_python(lambda: 7, None))
#### tiny evaluator (§4)
def is_tagged_llist(component, the_tag):
    return is_pair(component) and head(component) == the_tag
def evaluate(component):
    if is_tagged_llist(component, "literal"):
        return head(tail(component))
    elif is_tagged_llist(component, "binary_operator_combination"):
        op = head(tail(component))
        a = evaluate(head(tail(tail(component))))
        b = evaluate(head(tail(tail(tail(component)))))
        return a + b if op == "+" else a - b if op == "-" else a * b if op == "*" else a / b
    else:
        return error("unknown component", component)
print(evaluate(parse("1 + 2 * 3 - 4")), evaluate(parse("10 / 4")))
print(evaluate(parse("x")))
#### ch4 has everything (§4)
xs = [1, 2]
s = integers_from(1)
p = llist(1)
set_head(p, 2)
print(xs, head(stream_tail(s)), p)
#### parse in ch3 (§3)
print(parse("1"))
