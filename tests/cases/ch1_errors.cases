#### reassignment (§1)
x = 1
print(x)
x = 2
#### reassign in function (§1)
def f():
    y = 1
    y = 2
    return y
print(f())
#### reassign parameter (§1)
def f(a):
    a = a + 1
    return a
print(f(1))
#### reassign both branches (§1)
def f(x):
    if x > 0:
        y = 1
    else:
        y = 2
    return y
print(f(1))
#### redefine function (§1)
def f():
    return 1
def f():
    return 2
#### def then assign (§1)
def f():
    return 1
f = 2
