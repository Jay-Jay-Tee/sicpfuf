print(factorial(4))
-> print(1 if 4 == 1 else 4 * factorial(4 - 1))
-> print(1 if False else 4 * factorial(4 - 1))
-> print(4 * factorial(4 - 1))
-> print(4 * factorial(3))
-> print(4 * (1 if 3 == 1 else 3 * factorial(3 - 1)))
-> print(4 * (1 if False else 3 * factorial(3 - 1)))
-> print(4 * (3 * factorial(3 - 1)))
-> print(4 * (3 * factorial(2)))
-> print(4 * (3 * (1 if 2 == 1 else 2 * factorial(2 - 1))))
-> print(4 * (3 * (1 if False else 2 * factorial(2 - 1))))
-> print(4 * (3 * (2 * factorial(2 - 1))))
-> print(4 * (3 * (2 * factorial(1))))
-> print(4 * (3 * (2 * (1 if 1 == 1 else 1 * factorial(1 - 1)))))
-> print(4 * (3 * (2 * (1 if True else 1 * factorial(1 - 1)))))
-> print(4 * (3 * (2 * 1)))
-> print(4 * (3 * 2))
-> print(4 * 6)
-> print(24)
    output: 24

fact_iter(1, 1, 3)
-> 1 if 1 > 3 else fact_iter(1 * 1, 1 + 1, 3)
-> 1 if False else fact_iter(1 * 1, 1 + 1, 3)
-> fact_iter(1 * 1, 1 + 1, 3)
-> fact_iter(1, 1 + 1, 3)
-> fact_iter(1, 2, 3)
-> 1 if 2 > 3 else fact_iter(2 * 1, 2 + 1, 3)
-> 1 if False else fact_iter(2 * 1, 2 + 1, 3)
-> fact_iter(2 * 1, 2 + 1, 3)
-> fact_iter(2, 2 + 1, 3)
-> fact_iter(2, 3, 3)
-> 2 if 3 > 3 else fact_iter(3 * 2, 3 + 1, 3)
-> 2 if False else fact_iter(3 * 2, 3 + 1, 3)
-> fact_iter(3 * 2, 3 + 1, 3)
-> fact_iter(6, 3 + 1, 3)
-> fact_iter(6, 4, 3)
-> 6 if 4 > 3 else fact_iter(4 * 6, 4 + 1, 3)
-> 6 if True else fact_iter(4 * 6, 4 + 1, 3)
-> 6

